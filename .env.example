# Copy to .env.local and fill in. Never commit real values.

# Public site address (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://expressmebel.uz

# Leads → Telegram: create a bot with @BotFather, add it to the sales group, put the group id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Leads → ERP / CRM (JSON POST). Fill in when the ERP API is ready.
CRM_WEBHOOK_URL=
CRM_API_TOKEN=

# Ad and analytics tags (each loads only when set)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
